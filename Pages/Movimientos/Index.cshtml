@page
@model StockLentes.Pages.Movimientos.IndexModel
@using StockLentes.Services
@{ViewData["Title"]="Movimientos";}
<p class="eyebrow">TRAZABILIDAD</p><h1>Movimientos</h1><p>Últimos 100 registros de la búsqueda. Cada cambio conserva cantidad anterior, variación y resultado.</p>
<form method="get" class="search"><input asp-for="Search" aria-label="Buscar movimientos" placeholder="Código, producto u orden"/><select asp-for="Kind" aria-label="Tipo de movimiento"><option value="">Todos los tipos</option><option value="BAJA">BAJA POR PEDIDO</option><option value="ENTRADA">ENTRADA</option><option value="AJUSTE">AJUSTE MANUAL</option><option value="INICIAL">CARGA INICIAL</option><option value="BAJA_SIN_STOCK_CONTROLADO">USO SIN CONTROL DE STOCK</option></select><button class="button secondary">Buscar</button><a asp-page="Index">Ver todos</a></form>
<div class="panel table-wrap"><table><thead><tr><th>Fecha / hora UTC</th><th>Producto / pedido</th><th>Utilizado / combinación</th><th>Tipo</th><th>Cambio (pares)</th><th>Anterior → resultante</th><th>Motivo</th></tr></thead><tbody>
@foreach(var m in Model.Rows){var original=MovementDisplay.Original(m);<tr><td>@m.CreatedAtUtc.ToString("dd/MM/yyyy HH:mm")</td><td><strong>@m.ActualProductName</strong><small>@m.ActualProductCode</small>@if(m.OrderLens!=null){<small><a asp-page="/Pedidos/Detalle" asp-route-id="@m.OrderLens.LensOrderId">Orden @m.OrderLens.Order.ExternalNumber · @m.OrderLens.Eye · @m.OrderLens.PairType / @m.OrderLens.PairNumber</a></small>}</td><td>@MovementDisplay.Combination(m)
@if(original!=null){<details><summary>Solicitado originalmente</summary><p>@original.Code · @original.Name</p><p>ESF @(original.Sphere??"—") · CIL @(original.Cylinder??"—") · EJE @(original.Axis??"—") · ADD @(original.Add??"—") · BASE @(original.Base??"—")</p>@foreach(var s in original.Sections??[]){<p>@s.Section: ESF @(s.Sphere??"—") · CIL @(s.Cylinder??"—") · EJE @(s.Axis??"—")</p>}</details>}
</td><td><span class="badge muted">@MovementDisplay.Kind(m.Kind)</span></td><td class="quantity">@(m.QuantityHalfPairs>0?"+":"")@LensValues.Pairs(m.QuantityHalfPairs)</td><td>@(m.StockBeforeHalfPairs.HasValue?LensValues.Pairs(m.StockBeforeHalfPairs.Value):"—") → @(m.StockAfterHalfPairs.HasValue?LensValues.Pairs(m.StockAfterHalfPairs.Value):"—")</td><td>@m.Reason</td></tr>}
@if(Model.Rows.Count==0){<tr><td colspan="7" class="empty">No hay movimientos para esta búsqueda.</td></tr>}
</tbody></table></div>
