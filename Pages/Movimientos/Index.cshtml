@page
@model StockLentes.Pages.Movimientos.IndexModel
@using StockLentes.Services
@{ViewData["Title"]="Movimientos";}
<p class="eyebrow">TRAZABILIDAD</p><h1>Movimientos</h1><p>Últimos 100 registros. Las cargas y ajustes conservan el saldo anterior y posterior.</p>
<div class="panel table-wrap"><table><thead><tr><th>Fecha / hora UTC</th><th>Producto</th><th>Tipo</th><th>Cambio (pares)</th><th>Saldo</th><th>Motivo</th></tr></thead><tbody>
@foreach(var m in Model.Rows){<tr><td>@m.CreatedAtUtc.ToString("dd/MM/yyyy HH:mm")</td><td><strong>@m.ActualProductName</strong><small>@m.ActualProductCode</small>@if(m.OrderLens!=null){<small><a asp-page="/Pedidos/Detalle" asp-route-id="@m.OrderLens.LensOrderId">Orden @m.OrderLens.Order.ExternalNumber · @m.OrderLens.Eye · @m.OrderLens.PairType / @m.OrderLens.PairNumber</a></small><small>@m.OrderLens.Order.PatientName · @(m.OrderLens.Order.Store?.Name??"Óptica pendiente")</small>}</td><td><span class="badge muted">@m.Kind</span></td><td class="quantity">@(m.QuantityHalfPairs>0?"+":"")@LensValues.Pairs(m.QuantityHalfPairs)</td><td>@(m.StockBeforeHalfPairs.HasValue?LensValues.Pairs(m.StockBeforeHalfPairs.Value):"—") → @(m.StockAfterHalfPairs.HasValue?LensValues.Pairs(m.StockAfterHalfPairs.Value):"—")</td><td>@m.Reason</td></tr>}
@if(Model.Rows.Count==0){<tr><td colspan="6" class="empty">Todavía no hay movimientos.</td></tr>}
</tbody></table></div>
