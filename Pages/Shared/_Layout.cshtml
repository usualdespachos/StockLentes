<!DOCTYPE html>
<html lang="es"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1.0"/><title>@ViewData["Title"] · StockLentes</title><link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/></head><body>
<div class="app-shell"><aside class="sidebar"><a class="brand" asp-page="/Index">◉ Stock<span>Lentes</span></a><small>ÓPTICA & LABORATORIO</small><p class="nav-caption">ESPACIO DE TRABAJO</p><nav aria-label="Navegación principal">
@foreach(var item in new[]{("/Index","Inicio","⌂"),("/Pedidos/Index","Pedidos","▤"),("/Stock/Index","Stock","▦"),("/Productos/Index","Productos","◇"),("/Movimientos/Index","Movimientos","↗")}){
var current=ViewContext.RouteData.Values["page"]?.ToString()??"";var active=item.Item1=="/Index"?current=="/Index":current.StartsWith(item.Item1.Replace("/Index",""));
<a asp-page="@item.Item1" class="@(active?"active":"")" aria-current="@(active?"page":null)"><span>@item.Item3</span>@item.Item2</a>}
</nav><div class="sidebar-bottom">● Desarrollo local<small>Etapa 2 · Pedidos y bajas</small></div></aside>
<div class="workspace"><header class="topbar"><span>Laboratorio central / @ViewData["Title"]</span><span class="environment">ENTORNO DE DESARROLLO</span></header><main><div class="demo-banner">◌ <strong>Datos de demostración</strong> · Los productos DEMO no representan existencias reales.</div>
@if(TempData["Success"] is string message){<div class="success" role="status">@message</div>}@RenderBody()
</main><footer class="app-footer">StockLentes <span>Un inventario, cada lente registrada.</span></footer></div></div>@await RenderSectionAsync("Scripts",required:false)</body></html>
